  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/tpivacek/tn-appliance-tools/colony-loop/parts/watch.js</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/tpivacek/tn-appliance-tools/colony-loop/parts</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>OWNER_PHONE_NUMBER</key>
    <string>+16154855795</string>
    <key>XANO_INTAKE_BASE</key>
    <string>https://xbtp-g9bh-ditq.n7e.xano.io/api:3e_TffpA</string>
  </dict>

  <key>RunAtLoad</key>
