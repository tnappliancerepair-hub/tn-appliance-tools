<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tnappliance.verify-backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/tpivacek/tn-appliance-tools/colony-loop/scripts/verify-xano-backup.js</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/tpivacek/tn-appliance-tools/colony-loop</string>
  <!-- Sun 4am CT (09:00 UTC) — 45min after the daily backup at 3:15am -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>0</integer>
    <key>Hour</key>
    <integer>4</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/tpivacek/Library/Logs/verify-backup.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/tpivacek/Library/Logs/verify-backup.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
