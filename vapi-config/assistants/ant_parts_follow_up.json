            "required": ["job_id", "supplier", "outcome"]
          }
        },
        "server": { "url": "https://xbtp-g9bh-ditq.n7e.xano.io/api:3e_TffpA/record_parts_vendor_response" }
      },
      {
        "type": "transferCall",
        "destinations": [
          {
            "type": "number",
            "number": "+16154855795",
            "message": "One second, transferring you to our owner."
